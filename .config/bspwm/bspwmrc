#! /bin/sh
picom &
nitrogen --restore &

caffeine-indicator &
caffeine start --activate &

# auto-lock using slock after idle
# xss-lock -- slock &

pgrep -x sxhkd >/dev/null || sxhkd &

# Wait for the second DP output to appear before applying the final layout.
i=0
while [ "$i" -lt 10 ]; do
  if xrandr --query | grep -q '^DisplayPort-2 connected'; then
    break
  fi
  i=$((i + 1))
  sleep 1
done

# New OLED as primary, old primary as secondary.
xrandr \
  --output DisplayPort-1 --primary --mode 2560x1440 --rate 120.00 \
  --output DisplayPort-2 --mode 1920x1080 --rate 120.00 --rotate right --right-of DisplayPort-1 \
  --output HDMI-A-0 --off

# Remove the disconnected HDMI monitor from bspwm so its desktop does not
# leak into the primary monitor's workspace list.
if bspc query -M --names | grep -qx HDMI-A-0; then
  bspc monitor HDMI-A-0 -r
fi

bspc monitor DisplayPort-1 -d 1 2 3 4 5
bspc monitor DisplayPort-2 -d 0

if bspc query -D -m DisplayPort-1 --names | grep -qx Desktop; then
  bspc desktop Desktop -r
fi

bspc config border_width 1
bspc config window_gap 0

bspc config -m DisplayPort-1 window_gap 0
bspc config -m DisplayPort-2 window_gap 1

bspc config split_ratio 0.5

bspc config borderless_monocle true
bspc config gapless_monocle true

bspc config top_monocle_padding 0
bspc config bottom_monocle_padding 0
bspc config left_monocle_padding 0
bspc config right_monocle_padding 0

bspc config focused_border_color "#ff0000"
bspc config normal_border_color "#141415"

# rules (not working)
bspc rule -a qbittorrent state=floating rectangle=1280x720+0+0 center=true

"$HOME/.config/polybar/launch.sh"
xsetroot -cursor_name left_ptr &
